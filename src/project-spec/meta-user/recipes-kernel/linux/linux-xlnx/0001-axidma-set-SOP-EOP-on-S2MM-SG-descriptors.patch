--- a/drivers/dma/xilinx/xilinx_dma.c	2026-09-30 22:01:43.464000135 +0800
+++ b/drivers/dma/xilinx/xilinx_dma.c	2026-10-04 15:11:21.300743258 +0800
@@ -2191,14 +2191,20 @@
 				   struct xilinx_axidma_tx_segment, node);
 	desc->async_tx.phys = segment->phys;
 
-	/* For the last DMA_MEM_TO_DEV transfer, set EOP */
-	if (chan->direction == DMA_MEM_TO_DEV) {
-		segment->hw.control |= XILINX_DMA_BD_SOP;
-		segment = list_last_entry(&desc->segments,
-					  struct xilinx_axidma_tx_segment,
-					  node);
-		segment->hw.control |= XILINX_DMA_BD_EOP;
-	}
+	/*
+	 * Delimit the SG packet: SOP on the first descriptor, EOP on the last.
+	 * Xilinx only set these for DMA_MEM_TO_DEV (MM2S).  The DEV_TO_MEM
+	 * (S2MM) direction was skipped, which left the SG descriptor without
+	 * the End-of-Packet bit.  AXI DMA in SG mode then never terminates the
+	 * buffer (it keeps waiting past BTT for stream end), the descriptor is
+	 * never retired, the Dly/FrmCnt completion IRQ never fires and the
+	 * channel wedges.  Set SOP/EOP for both directions.
+	 */
+	segment->hw.control |= XILINX_DMA_BD_SOP;
+	segment = list_last_entry(&desc->segments,
+				  struct xilinx_axidma_tx_segment,
+				  node);
+	segment->hw.control |= XILINX_DMA_BD_EOP;
 
 	return &desc->async_tx;
 
